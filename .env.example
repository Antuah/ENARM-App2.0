# Desarrollo: npm run dev. Sin DATABASE_URL se usa PostgreSQL embebido (PGlite).
NODE_ENV=development
HOST=127.0.0.1
PORT=3001
APP_ORIGIN=http://127.0.0.1:5173
API_PROXY_TARGET=http://127.0.0.1:3001
DATABASE_URL=
# Azure: deja DATABASE_URL vacío y completa estos campos.
# PGHOST=tu-servidor.postgres.database.azure.com
# PGPORT=5432
# PGDATABASE=entrenarme
# PGUSER=enarmadmin
# PGPASSWORD="tu-contraseña"
# Con Azure usa DATABASE_SSL=true.
DATABASE_SSL=false
DATA_DIR=server/data
SEED_SAMPLE_BANK=true
TRUST_PROXY=false

# En producción configurar NODE_ENV=production, APP_ORIGIN=https://tu-dominio,
# DATABASE_URL de PostgreSQL, SEED_SAMPLE_BANK=false y HOST=0.0.0.0.
# TRUST_PROXY=true solo detrás de un proxy de confianza que filtre el acceso.
# DATABASE_SSL=true cuando el proveedor exige TLS con certificado verificable.
# Para servir el frontend compilado también en desarrollo: SERVE_FRONTEND=true.
# Azure API con frontend en Render: SERVE_FRONTEND=false.
# APP_ORIGIN debe ser la URL HTTPS del frontend; Render debe reenviar /api/* a Azure.

# Sin SMTP en desarrollo los correos se guardan en server/data/outbox/.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Entrenarme <no-reply@example.com>
