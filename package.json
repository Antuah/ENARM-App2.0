{
  "name": "entrenarme-web",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently --kill-others -n api,web \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node --env-file-if-exists=.env --watch server/index.js",
    "dev:web": "vite --host 127.0.0.1",
    "build": "vite build",
    "start": "node --env-file-if-exists=.env server/index.js",
    "preview": "vite preview --host 127.0.0.1",
    "db:migrate": "node --env-file-if-exists=.env server/cli.js migrate",
    "db:check": "node --env-file-if-exists=.env server/cli.js check",
    "db:seed": "node --env-file-if-exists=.env server/cli.js seed",
    "bank:import": "node --env-file-if-exists=.env server/cli.js import",
    "deploy:prepare": "node scripts/prepare-azure.mjs",
    "deploy:prepare:full": "node scripts/prepare-azure.mjs --with-frontend",
    "test": "node --test --test-concurrency=1 server/test/*.test.js",
    "format": "prettier --write src server vite.config.js package.json README.md docs"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@fastify/cookie": "^11.1.2",
    "@fastify/helmet": "^13.1.1",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/static": "^10.1.5",
    "@fontsource-variable/manrope": "^5.2.8",
    "@fontsource/chakra-petch": "^5.2.6",
    "fastify": "^5.12.5",
    "lucide-react": "^0.468.0",
    "nodemailer": "^10.0.12",
    "pg": "^8.23.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.5.0",
    "concurrently": "^10.0.5",
    "prettier": "^3.9.8",
    "vite": "^6.3.0"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
